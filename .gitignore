# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# next.js / build output
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# local reference docs (SRD 5.2.1 PDF lives here; not tracked)
/docs/

# SRD data pipeline (generated or downloaded; src/data/srd/ stays tracked)
# raw source JSON, and the PDF if downloaded rather than read from docs/
/.cache/
# per-entry JSON generated by `pnpm srd:emit`
/public/srd/
# output of `pnpm srd:verify`
/scripts/srd/report.md

# env files (keep the example)
.env*
!.env.example

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# deployment
.vercel

# OS / editors
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code personal settings (shared project settings stay tracked)
.claude/settings.local.json

# Cloudflare (OpenNext build output, wrangler state)
/.open-next/
/.wrangler/
.dev.vars*
